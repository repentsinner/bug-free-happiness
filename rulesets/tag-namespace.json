{
  "name": "Tag namespace",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/v*", "refs/tags/*/v*"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" }
  ],
  "bypass_actors": [
    {
      "actor_id": "${FLYWHEEL_APP_ID}",
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ]
}
